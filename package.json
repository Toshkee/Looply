{
  "name": "looply",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.17",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm test -- --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "testMatch": [
      "**/?(*.)test.[jt]s?(x)"
    ]
  }
}
